# Lore Vault 自架設定範本：複製成 .env 後依需要修改（.env 不進版控）。
#   cp .env.example .env
# 全部都是選配；留空或註解掉即採用預設值。
# 同一份 .env 同時供 docker compose 插值（埠、profile 等）與容器環境變數使用。

# ── compose profiles ────────────────────────────────────────────────
# 逗號分隔。ollama＝附帶 Ollama 容器並自動拉 embedding 模型；tunnel＝附帶 cloudflared。
# 自架者建議至少啟用 ollama（主機已有 Ollama 的話可不啟用）。
COMPOSE_PROFILES=ollama

# ── 對外位址 ────────────────────────────────────────────────────────
# 主機上發布的介面與埠（容器內固定 8000）。預設只綁本機。
# 改成 0.0.0.0 會把「沒有 TLS 的 HTTP」直接對外：bearer token 以明文傳送，
# UI 登入 cookie（預設 Secure）在純 http 下也無法使用。對外請用 tunnel profile 或自備 TLS 反向代理。
# LORE_VAULT_BIND=127.0.0.1
# LORE_VAULT_PORT=5056

# ── 認證 ────────────────────────────────────────────────────────────
# MCP／HTTP API 的 bearer token。未設時首次啟動自動產生，存於 volume 的
# /data/secrets/api-token，並在 log 印一次。環境變數優先：日後改設這個值會取代產生的 token，
# 已連線的客戶端要用新 token 重新登記。
# LORE_VAULT_API_TOKEN=

# 單一使用者的 principal 名稱（寫入紀錄的擁有者；預設 owner）。啟用後不要再改。
# LORE_VAULT_PRINCIPAL=owner

# Web UI 管理員。只在資料庫還沒有任何 UI 帳號時建立一次。
# 使用者名稱預設同 principal；未給密碼時產生一次性密碼，存於
# /data/secrets/initial-admin-password 並在 log 印一次（登入後請改密碼）。
# LORE_VAULT_ADMIN_USER=
# LORE_VAULT_ADMIN_PASSWORD=

# ── 模型 ────────────────────────────────────────────────────────────
# ask（整理回答）與摘要用的 OpenAI API key；未設時這兩項功能不可用，其餘照常。
# OPENAI_API_KEY=

# embedding 服務位址。未設時用主機上的 Ollama（http://host.docker.internal:11434）。
# 啟用 ollama profile 時必須改指向容器；停用 ollama profile 時這行也要一併註解掉：
LORE_VAULT_EMBEDDING_BASE_URL=http://ollama:11434
# embedding 模型（ollama profile 首次啟動會自動拉這個模型）。改模型前先確認維度相容。
# LORE_VAULT_EMBEDDING_MODEL=bge-m3

# ── 備份 ────────────────────────────────────────────────────────────
# 主機上的備份目錄（掛到容器 /backups，只放備份檔）。預設為 compose 檔旁的 ./backups。
# Linux 上請先建立並交給容器使用者：mkdir -p backups && sudo chown 10001:10001 backups
# LORE_VAULT_HOST_BACKUP_DIR=./backups

# ── Cloudflare Tunnel（tunnel profile）──────────────────────────────
# Cloudflare Zero Trust 後台建立 tunnel 取得的 token；公開主機名的服務目標填 http://lore-vault:8000
# TUNNEL_TOKEN=

# 受信任代理（逗號分隔的 IP／CIDR）：只有直接來源在清單內才採信 CF-Connecting-IP
# 作為登入紀錄的來源 IP。預設 172.16.0.0/12 涵蓋 Docker 預設網段；
# 若 compose 網路被分配到 192.168.x.x，改成該網段（docker network inspect lore-vault_default）。
# LORE_VAULT_UI_TRUSTED_PROXIES=172.16.0.0/12

# ── 映像版本（選配）────────────────────────────────────────────────
# OLLAMA_IMAGE=ollama/ollama:latest
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
